# Match data is 113MB and is redistributed under CC BY-NC-SA 4.0.
# Do not commit it. fetch_data.sh reproduces it.
data/

# External verification mirrors (TennisMyLife etc.) — download, do not commit
verification/external/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Working artefacts (large / local). Versioned run snapshots live under artifacts/models/.
*.pkl
runs/

# Ignore loose weight dumps, but allow frozen per-run models for GitHub progression
*.pt
!artifacts/models/**/*.pt

# macOS
.DS_Store

# Local tooling: graphify code graph (regenerate with `graphify update .`), agent worktrees
graphify-out/
.claude/

# Test and lint caches
.pytest_cache/
.ruff_cache/
